# Copy to .env.production and fill in values before:
# docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

POSTGRES_USER=calibre
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=calibre_crm

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Public URL users open in browser / Android app (HTTPS in real hosting)
FRONTEND_URL=http://YOUR_SERVER_IP:3000
BACKEND_URL=http://YOUR_SERVER_IP:3000
CORS_ORIGINS=http://YOUR_SERVER_IP:3000

# Ports on the host machine
WEB_PORT=3000
API_PORT=8000

# Optional
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
# Use a current Gemini model (gemini-2.0-flash is retired and returns 404)
GROOMING_VISION_MODEL=gemini-flash-latest

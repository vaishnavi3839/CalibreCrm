# Database
# Database — PostgreSQL (recommended for production / Docker)
# DATABASE_URL=postgresql+asyncpg://calibre:calibre_dev_password@localhost:5432/calibre_crm
# DATABASE_URL_SYNC=postgresql://calibre:calibre_dev_password@localhost:5432/calibre_crm
# Local default without Docker:
DATABASE_URL=sqlite+aiosqlite:///./calibre_crm.db
DATABASE_URL_SYNC=sqlite:///./calibre_crm.db

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Calibre Aviation Academy CRM
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Object Storage (S3-compatible / MinIO for local)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=calibre-crm
S3_REGION=us-east-1
S3_USE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Notification providers (leave empty to use console/log adapters)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@calibreaviation.academy

SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

PUSH_PROVIDER=
PUSH_API_KEY=

# Zoom (optional)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Google Sign-In (OAuth Web client ID — public; also set on frontend as NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=113963656390-odafike631l3st0onl83t4181b0vj75m.apps.googleusercontent.com

# Grooming selfie AI (required to check hair / facial grooming / appearance)
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or use OpenAI instead:
OPENAI_API_KEY=
# Optional model override (defaults: gemini-2.0-flash / gpt-4o-mini)
GROOMING_VISION_MODEL=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
